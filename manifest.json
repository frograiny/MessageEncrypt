{
  "manifest_version": 3,
  "name": "Message Encrypt",
  "version": "1.0.0",
  "description": "Mã hóa tin nhắn Messenger để bảo vệ privacy",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://www.facebook.com/*",
    "https://www.messenger.com/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.facebook.com/*",
        "https://www.messenger.com/*"
      ],
      "js": [
        "src/crypto.js",
        "src/content.js"
      ],
      "css": ["src/styles.css"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "Message Encrypt"
  }
}
